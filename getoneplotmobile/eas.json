{
  "cli": {
    "version": ">= 16.17.4",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "node": "24.16.0",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_URL": "http://localhost:8081",
        "EXPO_PUBLIC_API_URL": "http://localhost:3000"
      }
    },
    "preview": {
      "node": "24.16.0",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_URL": "https://getoneplot.com",
        "EXPO_PUBLIC_API_URL": "https://getoneplot.com"
      }
    },
    "production": {
      "node": "24.16.0",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_URL": "https://getoneplot.com",
        "EXPO_PUBLIC_API_URL": "https://getoneplot.com"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal"
      },
      "ios": {
        "ascAppId": "6789732741"
      }
    }
  }
}
